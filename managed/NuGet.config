<?xml version="1.0" encoding="utf-8"?>
<!-- The package sources the managed projects restore from: none of their own. The one package they use (Microsoft.CodeAnalysis.CSharp, for
     Aver.Fabric.Convert) comes from the engine's vendored third_party/nuget, which Directory.Build.props adds as a restore source, so the
     restore needs no network and takes nothing from a feed nobody here declared. -->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
