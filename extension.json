{
  "name": "FabricConnector",
  "displayName": "Fabric Connector",
  "version": "0.1.0-alpha",
  "abi": 2,
  "engine": ">=0.7.0 <0.9.0",
  "license": "LGPL-2.1",
  "source": "https://github.com/Vectoric-Core-Systems/Fabric-Connector",
  "native": "Aver.Fabric.Native",
  "managed": { "runtime": ["Aver.Fabric.dll"], "entry": "Aver.Fabric.FabricExtension", "actorBase": "Aver.Fabric.Node" },
  "commands": [ { "name": "fabric", "summary": "convert a Godot 4 project", "usage": "<godot-project-dir> <out-dir> [--dry-run] [--scenes-only] [--scripts-only] [--overwrite]" } ],
  "importers": [ {
    "id": "godot-project",
    "menu": "Import Godot Project...",
    "startButton": "Import Godot 4 Project...",
    "tooltip": "Convert a Godot 4.1+ project (scenes, assets, scripts, GDExtensions) into an Aver project.\nSee docs/FABRIC.md.",
    "description": "Converts a Godot 4.1+ project (3D scenes, assets, scripts and GDExtensions) into a standalone Aver project in <output folder>/<Name>. The Godot project is only read. What did not convert is listed in FabricReport.md.",
    "command": "fabric",
    "input": { "kind": "folder", "detect": "project.godot" },
    "outputDefault": "{input}_Aver",
    "options": [
      { "flag": "--overwrite", "label": "Replace a project already converted there" },
      { "flag": "--dry-run", "label": "Report only (convert nothing to disk)" }
    ]
  } ],
  "runtimeFiles": ["native/{platform}/Aver.Fabric.Native.*", "managed/Aver.Fabric.dll", "data/extension_api.json"]
}
