; Engine configuration file.
; A fixture for wave 4 of the Godot parity plan (FabricWave4Test): viewport and shadow settings, glow, ambient, volumetric fog, per-instance flags, a light projector.

config_version=5

[application]

config/name="Wave4 Game"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[rendering]

anti_aliasing/quality/msaa_3d=3
anti_aliasing/quality/use_taa=true
anti_aliasing/quality/use_debanding=true
scaling_3d/mode=1
scaling_3d/scale=0.67
scaling_3d/fsr_sharpness=0.5
mesh_lod/lod_change/threshold_pixels=2.0
occlusion_culling/use_occlusion_culling=true
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/atlas_size=2048
