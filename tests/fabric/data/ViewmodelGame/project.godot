; Engine configuration file.
; A fixture for the first-person work (FabricViewmodelTest): a viewmodel shader (its own projection and depth push) and an ordinary one, each used by
; a material_override, a surface override, a mesh resource's own material and a model whose import replaces its material.

config_version=5

